# Hugging Face token with access to Gemma model weights.
HUGGING_FACE_HUB_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxx

# Replace with secure random strings.
LITELLM_MASTER_KEY=replace-me-master-key
LITELLM_SALT_KEY=replace-me-salt-key

# Model/runtime tuning
MODEL_ID=google/gemma-4-27b-it
GPU_MEMORY_UTILIZATION=0.90
MAX_MODEL_LEN=8192
TENSOR_PARALLEL_SIZE=1

# Optional: point to your OpenClaw image tag
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest
OPENCLAW_MODEL_ALIAS=gemma-4
